# -------------------
# DOMAIN SETTINGS
# -------------------
DOMAIN=ovitv.ddns.net
EMAIL=your@email.com

# -------------------
# ADMIN LOGIN (backend/models/db.go)
# -------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SuperSecure2025!

# -------------------
# SESSION SECRET
# MUST be 32+ random chars
# -------------------
SESSION_SECRET=somerandom32charsecret

# -------------------
# CLIENT WS URL (Next.js)
# -------------------
NEXT_PUBLIC_WS_URL=wss://ovitv.ddns.net/ws

# -------------------
# RATE LIMIT CONFIG
# (Used in middleware/rate_limit.go)
# -------------------
RATE_LIMIT_BURST=10
RATE_LIMIT_REFILL=1m

# -------------------
# ENVIRONMENT
# Enables HSTS, secure cookies, CORS production mode
# -------------------
ENV=production
