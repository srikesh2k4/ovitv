{
  "services": {
    "backend": {
      "rootDirectory": "backend",
      "dockerfilePath": "backend/Dockerfile",
      "deploy": {
        "port": 8080,
        "startCommand": "./server"
      }
    },
    "client": {
      "rootDirectory": "client",
      "dockerfilePath": "client/Dockerfile",
      "deploy": {
        "port": 3000,
        "startCommand": "node server.js"
      }
    },
    "admin": {
      "rootDirectory": "admin",
      "dockerfilePath": "admin/Dockerfile",
      "deploy": {
        "port": 3001,
        "startCommand": "node server.js"
      }
    }
  }
}
